<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Override the single TargetFramework inherited from Directory.Build.props: THIS package
         multi-targets so the net8 straggler (AMLService, net8) can consume it in Phase 2, while the
         test project keeps inheriting the single net10 target. Clearing TargetFramework then setting
         TargetFrameworks is the documented override pattern. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Dloizides.Jobs</RootNamespace>
    <PackageId>Dloizides.Jobs</PackageId>
  </PropertyGroup>

  <!--
    Storage-agnostic on purpose: NO Entity Framework, NO provider. The core depends only on the
    hosting/DI/logging abstractions every host already carries, so any store (EF, Dapper, an in-memory
    fake) can back it. Versions are 8.0.x FLOORS — they resolve forward on a net10 host and keep the
    net8 consumer buildable. TimeProvider comes from the BCL on net8+, so no System.* package is needed.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
  </ItemGroup>

</Project>
